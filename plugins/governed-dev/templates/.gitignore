# Generated artifacts. Seeded because gate.sh runs tools that write into the
# working tree (pytest writes __pycache__/), and check 4 would otherwise read
# those as source changes. The gate excludes this set unconditionally too --
# this file is the second half of that fix, so a bootstrapped project starts
# with a tree that stays clean. See ADR-0005.

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.venv/
venv/

# Node
node_modules/
dist/
build/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# Local environment and secrets
.env
.env.*
!.env.example
